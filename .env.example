NEXT_PUBLIC_SITE_URL=https://love.atimefriend.cn
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# 下面的连接信息供不使用 production compose 时覆盖；compose 会在容器网络内自动注入。
DATABASE_URL=postgresql://love:change-me@127.0.0.1:5432/love
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=love
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
